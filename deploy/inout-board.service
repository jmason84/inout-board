[Unit]
Description=IN/OUT Board
After=network.target

[Service]
Type=simple
User=inout
Group=inout
WorkingDirectory=/opt/inout-board
EnvironmentFile=/etc/inout-board.env
Environment=DATA_DIR=/var/lib/inout-board
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inout-board

[Install]
WantedBy=multi-user.target
