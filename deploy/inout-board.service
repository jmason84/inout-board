[Unit]
Description=IN/OUT Board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inout
Group=inout
WorkingDirectory=/opt/inout-board
# Defaults (match the Windows installer): built-in HTTPS on 8443. Anything in the
# env file below overrides these, because later assignments win.
Environment=PORT=8443
Environment=HTTPS=auto
Environment=DATA_DIR=/var/lib/inout-board
EnvironmentFile=-/etc/inout-board.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inout-board

[Install]
WantedBy=multi-user.target
