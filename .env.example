# Copy to .env and edit. Never commit .env.

# First admin account. These are ONLY used on the very first start, when no
# admin exists yet. After that, manage admins inside the app (Admin > Admins).
# If ADMIN_PASSWORD is left empty a random one is generated and printed once
# in the logs:  docker compose logs app
ADMIN_USER=admin
ADMIN_PASSWORD=

# Host port to publish (container always listens on 3000)
HOST_PORT=3000

# Behind HTTPS (Cloudflare Tunnel, Caddy, nginx...) set COOKIE_SECURE=1.
# WARNING: with COOKIE_SECURE=1 logins only work over https://. Leave it
# unset while testing over plain http://server-ip:3000
COOKIE_SECURE=
# Behind a reverse proxy / tunnel, set to 1 so the real client IP is used for
# login throttling and the https scheme is honoured.
TRUST_PROXY=

# Only for:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=
