# Copy to .env and edit (optional: the defaults work as is). Never commit .env.

# First admin account. These are ONLY used on the very first start, when no
# admin exists yet. After that, manage admins inside the app (Admin > Admins).
# Default is admin / admin: you must choose a new password (10+ characters)
# at first sign-in, before anything else works - do that right after starting.
# Set a strong ADMIN_PASSWORD here instead to skip the forced change.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Host port to publish (the container always listens on 8443, HTTPS).
HOST_PORT=8443

# Built-in HTTPS: "auto" = private CA + certificate (CA downloadable at /ca.crt).
# Use "off" only behind a TLS-terminating proxy or tunnel (then also set
# COOKIE_SECURE=1 and TRUST_PROXY=1 below).
HTTPS=auto

# Addresses to put in the certificate, comma-separated. Inside Docker the app
# cannot see the server's real LAN address, so list it here, e.g.
#   EXTRA_ADDRESSES=192.168.1.50,board.office.lan
# (the certificate is re-issued automatically when this changes and the app restarts)
EXTRA_ADDRESSES=

# Nightly backup (service "backup"): local time, how many to keep, time zone.
BACKUP_TIME=02:15
BACKUP_KEEP=14
TZ=UTC

# Behind HTTPS proxy/tunnel (Cloudflare Tunnel, Caddy, nginx...) set COOKIE_SECURE=1.
# WARNING: with COOKIE_SECURE=1 logins only work over https://.
# Not needed with HTTPS=auto (cookies are already Secure over TLS).
COOKIE_SECURE=
# Behind a reverse proxy / tunnel, set to 1 so the real client IP is used for
# login throttling and the https scheme is honoured.
TRUST_PROXY=

# Extra origins allowed to POST (comma-separated), only needed for unusual proxy setups
# where browsers don't send Sec-Fetch-Site. Example: https://board.example.com
ALLOWED_ORIGINS=

# Only for:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=
